# SeekFeed Docker 环境变量配置模板
# 复制此文件为 .env 并修改相应的值

# ===========================================
# 服务器配置
# ===========================================
PORT=3010
HOST=0.0.0.0
NODE_ENV=production
# 允许的跨域源，多个用逗号分隔
CORS_ORIGINS=http://localhost:3010,https://your-domain.com

# ===========================================
# 数据库配置
# ===========================================
DATABASE_PATH=./data/seekfeed.db

# ===========================================
# RSS 配置
# ===========================================
# RSS 请求超时（毫秒）
RSS_TIMEOUT=30000
# 是否启用 RSS 定时抓取
RSS_CHECK_ENABLED=true

# 独立热榜：每 300 秒通过 HTTP 采集；浏览器仅用于人工验证。
HOT_COLLECT_ENABLED=true
# 同一服务器上的私有 CF 会话文件，不含 NodeSeek 登录 Cookie；勿提交或记录其内容。
# HOT_HTTP_SESSION_PATH=./data/hot-http-session.json

# 注意：以下 RSS 配置已迁移到数据库，可在 Web 页面动态修改：
# - RSS 源地址（默认: https://rss.nodeseek.com/）
# - 抓取间隔秒数（默认: 30 秒）
# - HTTP/HTTPS 代理

# ===========================================
# Telegram 配置 (可选)
# ===========================================
# 注意：Telegram Bot Token 和用户绑定均通过 Web 界面配置，无需环境变量

# Webhook URL 可选覆盖（优先级高于自动检测）
# 格式: https://your-domain.com/telegram/webhook
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook

# Only enable behind a controlled reverse proxy that overwrites X-Real-IP.
# Keep the app port private; direct deployments must leave this false.
TRUST_PROXY=false

# 生产 Compose 的 verification profile 按需创建浏览器；日常保持关闭。
# 自定义部署时不公开 CDP 或 GUI 端口。
# HOT_BROWSER_ENDPOINT=http://seekfeed-browser:9222
# HOT_BROWSER_GUI_URL=http://seekfeed-browser:5800
